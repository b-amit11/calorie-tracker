# Copy to .env.local for local overrides. Everything is optional for local development.

# Database. Default: a local SQLite file (file:calories.db).
# Production (Turso): libsql://<db-name>-<org>.turso.io
# DATABASE_URL=
# DATABASE_AUTH_TOKEN=

# Free key from https://fdc.nal.usda.gov/api-key-signup (DEMO_KEY is heavily rate-limited)
# USDA_API_KEY=

# Set to "false" to close sign-ups or hide the "Try the demo" button.
# ALLOW_SIGNUP=true
# DEMO_ENABLED=true

# Where the browser looks for the trackpad scale helper.
# NEXT_PUBLIC_SCALE_URL=http://localhost:8787
